# EdgeBridge 설정
# 이 파일을 .env로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env는 .gitignore에 들어 있어 커밋되지 않습니다.

# 서버가 요청을 받을 IP. 비워 두면 모든 인터페이스에서 받습니다. (Docker에서는 무시됩니다)
SERVER_IP=
# 서버 포트
SERVER_PORT=8088

# SmartThings API 호출에 붙일 Personal Access Token (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
SMARTTHINGS_TOKEN=

# 외부로 전달하는 요청의 타임아웃(초)
FORWARDING_TIMEOUT=5

# 로그 출력: 콘솔 / 파일 / 디버그 메시지
CONSOLE_OUTPUT=yes
LOGFILE_OUTPUT=no
LOGFILE=edgebridge.log
DEBUG=no

# --- Docker 전용 ---
# 호스트에 노출할 포트
HOST_PORT=8088
# 로그 시각에 쓸 시간대
TZ=Asia/Seoul
